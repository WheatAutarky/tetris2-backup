using System.Numerics;
using System.Collections;
using System.Collections.Generic;
using System.Linq;
using UnityEngine;
using Vector3 = UnityEngine.Vector3;
using Quaternion = UnityEngine.Quaternion;
using UnityEngine.UIElements;
using UnityEngine.InputSystem;
using Unity.VisualScripting;
using UnityEngine.Rendering.RenderGraphModule;
using UnityEditor.Rendering.Universal.ShaderGUI;
public class GameManager : MonoBehaviour
{
    public GameObject[] Tetrominos;
    public float movementFrequency = 0.8f;
    private float passedTime = 0;
    private float DAS = 0.1f; //NES Tetris: 0.27f ---- My Settings: 0.1f
    private float ARR = 0.005f; //NES Tetris: 0.1f ---- My Settings: 0.005f
    private GameObject currentTetromino;
    private bool enableHold = true;

    List<GameObject> queue = new List<GameObject>();

    // Start is called once before the first execution of Update after the MonoBehaviour is created
    void Start()
    {
        /* THE CORRECT WAY - FIX BY DECOUPLING QUEUE[0] FROM CURRENT PIECE. current bug is that the first piece is immediately being removed by spawntetromino.
        GenerateBag();
        foreach (int i in generatedBag)
        {
            queue.Add(Instantiate(Tetrominos[i], new Vector3(12, 40, 0), Quaternion.identity)); //spawn them in off camera, and move them into camera when they reach top 5 queue (add this second half)
        }

        for (int i = 1; i <= 5; i++)
        {
            queue[i].transform.position = new Vector3(12, 22 - i*4, 0);
        }

        //start spawning pieces
        SpawnTetromino(); 
        */
        
        /* fuckass hack method by duplicating spawntetromino minus the removeat(0) line. get rid of asap. */
        GenerateBag();

        foreach (int i in generatedBag)
        {
            queue.Add(
                Instantiate(
                    Tetrominos[i],
                    new Vector3(12, 40, 0),
                    Quaternion.identity
                )
            );
        }

        currentTetromino = queue[0];

        for (int i = 1; i <= 5; i++)
        {
            queue[i].transform.position =
                new Vector3(12, 22 - i * 4, 0);
        }

        switch (queue[0].name)
        {
            case "I(Clone)":
                spawnCoords = new Vector3(4.5f, 20.5f, 0);
                break;

            case "O(Clone)":
                spawnCoords = new Vector3(4.5f, 21.5f, 0);
                break;

            default:
                spawnCoords = new Vector3(4, 21, 0);
                break;
        }

        currentTetromino.transform.position = spawnCoords;

        enableHold = true;
    }

    // Update is called once per frame
    void Update()
    {
        passedTime += Time.deltaTime;
        if (passedTime >= movementFrequency)
        {
            passedTime -= movementFrequency;
            MoveTetromino(Vector3.down);
        }
        UserInput();
    }

    float leftDASTimer = 0f;
    float leftARRTimer = 0f;
    float rightDASTimer = 0f;
    float rightARRTimer = 0f;
    enum Direction { None, Left, Right }
    Direction activeDirection = Direction.None;
    private GameObject switchPiece;
    private GameObject holdPiece;

    void UserInput()
    {

        bool leftPressed = Input.GetKeyDown(KeyCode.K);
        bool leftHeld = Input.GetKey(KeyCode.K);
        bool rightPressed = Input.GetKeyDown(KeyCode.Semicolon);
        bool rightHeld = Input.GetKey(KeyCode.Semicolon);
        bool clockwisePressed = Input.GetKeyDown(KeyCode.D);
        bool ccPressed = Input.GetKeyDown(KeyCode.S);
        bool softdropPressed = Input.GetKeyDown(KeyCode.L);
        bool softdropHeld = Input.GetKey(KeyCode.L);
        bool invertPressed = Input.GetKeyDown(KeyCode.A);
        bool harddropPressed = Input.GetKeyDown(KeyCode.Space);
        bool holdPressed = Input.GetKeyDown(KeyCode.F);

        if (leftPressed)
        {
            MoveTetromino(Vector3.left);
            leftDASTimer = DAS;
            leftARRTimer = 0f;
            activeDirection = Direction.Left;
        }

        if (rightPressed)
        {
            MoveTetromino(Vector3.right);
            rightDASTimer = DAS;
            rightARRTimer = 0f;
            activeDirection = Direction.Right;
        }


        if (!leftHeld && activeDirection == Direction.Left && rightHeld)
        {
            activeDirection = Direction.Right;
        }
        else if (!rightHeld && activeDirection == Direction.Right && leftHeld)
        {
            activeDirection = Direction.Left;
        }
        else if (!leftHeld && !rightHeld)
        {
            activeDirection = Direction.None;
        }

        if (leftHeld)
            leftDASTimer -= Time.deltaTime;

        if (rightHeld)
            rightDASTimer -= Time.deltaTime;

        int moves = 0;

        if (activeDirection == Direction.Left && leftHeld)
        {
            if (leftDASTimer <= 0f)
            {
                leftARRTimer -= Time.deltaTime;

                while (leftARRTimer <= 0f && moves < 10)
                {
                    MoveTetromino(Vector3.left);
                    leftARRTimer += ARR;
                    moves++;
                }
            }
        }
        else if (activeDirection == Direction.Right && rightHeld)
        {
            if (rightDASTimer <= 0f)
            {
                rightARRTimer -= Time.deltaTime;

                while (rightARRTimer <= 0f && moves < 10)
                {
                    MoveTetromino(Vector3.right);
                    rightARRTimer += ARR;
                    moves++;
                }
            }
        }

        int direction;
        if(clockwisePressed || ccPressed || invertPressed)  //add with getkey for infinite rotation later
        {
            if (clockwisePressed) {direction = -90;}
            else if (ccPressed) {direction = 90;}
            else {direction = 180;}

            if (!currentTetromino.name.Contains("O")) //disable rotation for O piece
            {
                currentTetromino.transform.Rotate(0,0,direction);
            } 

            if (!IsValidPosition())
            {
                currentTetromino.transform.Rotate(0,0,-direction);
            }
        }

        if (softdropPressed)
        {
            passedTime = 0;  //uncomment if it feels weird
        }
        if (softdropHeld)
        {
            movementFrequency = 0.05f; //every 0.05 seconds
        } 
        else
        {
            movementFrequency = 0.8f;  //back to standard current fall speed
        }

        if (harddropPressed)
        {
            while (true) //be careful not to allow any bugs that can permit pieces below the board
            {
                currentTetromino.transform.position += Vector3.down; //I do not understand how this sees the instantiation in SpawnTetronimo - do more research on class fields vs local variables

                if (!IsValidPosition())
                {
                    currentTetromino.transform.position -= Vector3.down; //note: this is a bit of a hack, but it works. The piece is moved down one more time than it should be, so we move it back up one space to correct it.
                    break;
                }
            }
            GetComponent<GridScript>().UpdateGrid(currentTetromino.transform);
            GetComponent<GridScript>().CheckForLines();
            SpawnTetromino();
            enableHold = true;
        }

        /* If hold is pressed and holding is enabled */
        if (holdPressed && enableHold)
        {
            if (holdPiece == null) //changed to be a separate gameobject
            {
                holdPiece = queue[0];
                holdPiece.transform.position = new Vector3(-3,17,0);
                SpawnTetromino();
                enableHold = false;
            }

            else
            {
                switchPiece = queue[0];
                queue[0] = holdPiece;
                holdPiece = switchPiece;
                holdPiece.transform.position = new Vector3(-3,17,0);
                holdPiece.transform.rotation = Quaternion.identity; //reset rotation when putting into the hold slot

                currentTetromino = queue[0];
                
                /* adjust spawn coordinates based on the piece, and place it on the grid */
                switch (queue[0].name)
                {
                    case "I(Clone)":
                        spawnCoords = new Vector3((float)4.5, (float)20.5, 0);
                        break;
                    case "O(Clone)":
                        spawnCoords = new Vector3((float)4.5, (float)21.5, 0);
                        break;
                    default:
                        spawnCoords = new Vector3(4, 21, 0);
                        break;

                }
                currentTetromino.transform.position = spawnCoords;

                /* Check for game over */
                if (!IsValidPosition())
                {
                    Time.timeScale = 0f;
                }
                enableHold = false;
            
            }
        }
    }

    Vector3 spawnCoords;
    void SpawnTetromino()
    {
        /* Shift the queue up */
        queue.RemoveAt(0);

        /* Top up queue if there isn't two full bags ready */
        if (queue.Count < 14)
        {
            GenerateBag();
            foreach (int i in generatedBag)
            {
                queue.Add(Instantiate(Tetrominos[i], new Vector3(12, 40, 0), Quaternion.identity)); //spawn them in off camera, and move them into camera when they reach top 5 queue (add this second half)
            }
        } 

        currentTetromino = queue[0];

        /* Visibly move the queue upwards*/
        for (int i = 1; i <= 5; i++)
        {
            queue[i].transform.position = new Vector3(12, 22 - i*4, 0);
        }

        /* Adjust spawn positions dependent on the piece */
        switch (queue[0].name)
        {
            case "I(Clone)":
                spawnCoords = new Vector3((float)4.5, (float)20.5, 0);
                break;
            case "O(Clone)":
                spawnCoords = new Vector3((float)4.5, (float)21.5, 0);
                break;
            default:
                spawnCoords = new Vector3(4, 21, 0);
                break;

        }
        currentTetromino.transform.position = spawnCoords; //finally set the position of the current tetromino to the decided spawn coordinates

        /* Temporary game over measure, doesn't actually end the game as you can still hard drop. */
        if (!IsValidPosition())
        {
            Time.timeScale = 0f;
        }

        enableHold = true;
    }


    /* Moves piece upon calling in a given direction */
    void MoveTetromino(Vector3 direction)
    {
        currentTetromino.transform.position += direction;
        if (!IsValidPosition())
        {
            currentTetromino.transform.position -= direction;
            /* If on top of the stack, triggered by gravity */
            if (direction == Vector3.down)
            {
                GetComponent<GridScript>().UpdateGrid(currentTetromino.transform);
                CheckForLines();
                SpawnTetromino();
                enableHold = true;
            }
        }
    }

    private int[] generatedBag = new int[7]; //magic number

/* Call this function to shuffle the bag */
    public void GenerateBag()
    {
        // Fill the array
        for (int i = 0; i < generatedBag.Length; i++)
        {
            generatedBag[i] = i;
        }

        // Fisher-Yates shuffle
        for (int i = generatedBag.Length - 1; i > 0; i--)
        {
            int j = Random.Range(0, i + 1);
            (generatedBag[i], generatedBag[j]) = (generatedBag[j], generatedBag[i]);
        }

        Debug.Log(
        $"Bag: {string.Join(", ", generatedBag)} | " +
        $"Pieces: {string.Join(", ", generatedBag.Select(i => Tetrominos[i].name))}"
        );
    }
    

    /* Ported functions from GridScript */
    bool IsValidPosition(){
        return GetComponent<GridScript>().IsValidPosition(currentTetromino.transform);
    }

    void CheckForLines(){
        GetComponent<GridScript>().CheckForLines();
    }

}
