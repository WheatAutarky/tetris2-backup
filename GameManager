public class GameManager : MonoBehaviour
{
    private GridScript gridScript;
    private InputHandler input = new InputHandler(); //InputHandler is not a MonoBehaviour class (attached to a gameobject as a component), so doesn't need a GetComponent call
    [SerializeField] private GameObject[] Tetrominos;
    [SerializeField] private float movementFrequency = 0.8f;
    private float passedTime = 0;
    [SerializeField] private float DAS = 0.1f; //NES Tetris: 0.27f ---- My Settings: 0.1f
    [SerializeField] private float ARR = 0.005f; //NES Tetris: 0.1f ---- My Settings: 0.005f
    private GameObject currentTetromino;
    private bool enableHold = true;
    private float leftDASTimer = 0f;
    private float leftARRTimer = 0f;
    private float rightDASTimer = 0f;
    private float rightARRTimer = 0f;
    private enum Direction { None, Left, Right }
    private Direction activeDirection = Direction.None;
    private Vector3 spawnCoords; //delete if the new GetSpawnLocation method works. Even if not, it doesn't need to be a class variable.
    private List<GameObject> queue = new List<GameObject>();
    private int[] generatedBag = new int[7]; //magic number

    void Awake()
    {
        gridScript = GetComponent<GridScript>();
    }

    void Start()
    {
        //GenerateBag();

        /* should be ok as spawntetromino generates new bags first thing, double check tho
        foreach (int i in generatedBag)
        {
            queue.Add(Instantiate(Tetrominos[i], new Vector3(12, 40, 0), Quaternion.identity)); //spawn them in off camera, and move them into camera when they reach top 5 queue (add this second half)
        }
        */
        SpawnTetromino();
    }

    void Update()
    {
        passedTime += Time.deltaTime;
        if (passedTime >= movementFrequency)
        {
            passedTime -= movementFrequency;
            MoveTetromino(Vector3.down);
        }

        HandleInput(input.GetSnapshot());
    }


    void HandleInput(InputSnapshot frameInput)
    {
        GameObject switchPiece;
        GameObject holdPiece;

        if (frameInput.LeftPressed)
        {
            MoveTetromino(Vector3.left);
            leftDASTimer = DAS;
            leftARRTimer = 0f;
            activeDirection = Direction.Left;
        }

        if (frameInput.RightPressed)
        {
            MoveTetromino(Vector3.right);
            rightDASTimer = DAS;
            rightARRTimer = 0f;
            activeDirection = Direction.Right;
        }

        if (!frameInput.LeftHeld && activeDirection == Direction.Left && frameInput.RightHeld)
        {
            activeDirection = Direction.Right;
        }
        else if (!frameInput.RightHeld && activeDirection == Direction.Right && frameInput.LeftHeld)
        {
            activeDirection = Direction.Left;
        }
        else if (!frameInput.LeftHeld && !frameInput.RightHeld)
        {
            activeDirection = Direction.None;
        }

        if (frameInput.LeftHeld)
            leftDASTimer -= Time.deltaTime;

        if (frameInput.RightHeld)
            rightDASTimer -= Time.deltaTime;

        int moves = 0;

        if (activeDirection == Direction.Left && frameInput.LeftHeld)
        {
            if (leftDASTimer <= 0f)
            {
                leftARRTimer -= Time.deltaTime;

                while (leftARRTimer <= 0f && moves < 10)
                {
                    MoveTetromino(Vector3.left);
                    leftARRTimer += ARR;
                    moves++;
                }
            }
        }
        else if (activeDirection == Direction.Right && frameInput.RightHeld)
        {
            if (rightDASTimer <= 0f)
            {
                rightARRTimer -= Time.deltaTime;

                while (rightARRTimer <= 0f && moves < 10)
                {
                    MoveTetromino(Vector3.right);
                    rightARRTimer += ARR;
                    moves++;
                }
            }
        }

        int direction;
        if (frameInput.ClockwisePressed || frameInput.CounterClockwisePressed || frameInput.InvertPressed) //add with getkey for infinite rotation later
        {
            if (frameInput.ClockwisePressed) { direction = -90; }
            else if (frameInput.CounterClockwisePressed) { direction = 90; }
            else { direction = 180; }

            if (!currentTetromino.name.Contains("O")) //disable rotation for O piece
            {
                currentTetromino.transform.Rotate(0, 0, direction);
            }

            if (!IsValidPosition())
            {
                currentTetromino.transform.Rotate(0, 0, -direction);
            }
        }

        if (frameInput.SoftDropPressed)
        {
            passedTime = 0; //uncomment if it feels weird
        }
        if (frameInput.SoftDropHeld)
        {
            movementFrequency = 0.05f; //every 0.05 seconds
        }
        else
        {
            movementFrequency = 0.8f; //back to standard current fall speed
        }

        if (frameInput.HardDropPressed)
        {
            while (true) //fix with something better, this is dangerous
            {
                currentTetromino.transform.position += Vector3.down;

                if (!IsValidPosition())
                {
                    currentTetromino.transform.position -= Vector3.down;
                    break;
                }
            }
            LockCurrentPiece();
        }

        /* If hold is pressed and holding is enabled */
        if (frameInput.HoldPressed && enableHold)
        {
            if (holdPiece == null) //changed to be a separate gameobject
            {
                holdPiece = queue[0];
                holdPiece.transform.position = new Vector3(-3, 17, 0);
                holdPiece.transform.rotation = Quaternion.identity; //reset rotation when putting into the hold slot
                queue.RemoveAt(0); //shift the queue up
                SpawnTetromino();
                enableHold = false;
            }
            else
            {
                switchPiece = queue[0];
                queue[0] = holdPiece;
                holdPiece = switchPiece;
                holdPiece.transform.position = new Vector3(-3, 17, 0);
                holdPiece.transform.rotation = Quaternion.identity;

                currentTetromino = queue[0];

                /* adjust spawn coordinates based on the piece, and place it on the grid */
                currentTetromino.transform.position = GetSpawnLocation(currentTetromino);

                /* Check for game over */
                if (!IsValidPosition())
                {
                    Time.timeScale = 0f;
                }
                enableHold = false;
            }
        }
    }

    
    public void SpawnTetromino()
    {
        /* Top up queue if there isn't two full bags ready */
        if (queue.Count < 14)
        {
            GenerateBag();
            foreach (int i in generatedBag)
            {
                queue.Add(Instantiate(Tetrominos[i], new Vector3(12, 40, 0), Quaternion.identity)); //change the magic numbers eventually
            }
        } 

        currentTetromino = queue[0];

        UpdateQueueDisplay();

        /* Adjust spawn positions dependent on the piece */
        currentTetromino.transform.position = GetSpawnLocation(currentTetromino);

        /* Temporary game over measure, doesn't actually end the game as you can still hard drop. */
        if (!IsValidPosition())
        {
            Time.timeScale = 0f;
        }

        enableHold = true;
    }


    /* Moves piece upon calling in a given direction */
    public void MoveTetromino(Vector3 direction)
    {
        currentTetromino.transform.position += direction;
        if (!IsValidPosition())
        {
            currentTetromino.transform.position -= direction;
            /* If on top of the stack, triggered by gravity */
            if (direction == Vector3.down)
            {
                LockCurrentPiece();
            }
        }
    }

   

/* Call this function to shuffle the bag */
    public void GenerateBag()
    {
        // Fill the array
        for (int i = 0; i < generatedBag.Length; i++)
        {
            generatedBag[i] = i;
        }

        // Fisher-Yates shuffle
        for (int i = generatedBag.Length - 1; i > 0; i--)
        {
            int j = Random.Range(0, i + 1);
            (generatedBag[i], generatedBag[j]) = (generatedBag[j], generatedBag[i]);
        }

        Debug.Log(
        $"Bag: {string.Join(", ", generatedBag)} | " +
        $"Pieces: {string.Join(", ", generatedBag.Select(i => Tetrominos[i].name))}"
        );
    }
    
    void UpdateQueueDisplay()
    {
        for (int i = 1; i <= 5; i++)
        {
            queue[i].transform.position = new Vector3(12, 22 - i*4, 0);
        }
    }

    private Vector3 GetSpawnLocation(GameObject piece) => piece.name switch
    {
        "I(Clone)" => new Vector3(4.5f, 20.5f, 0),
        "O(Clone)" => new Vector3(4.5f, 21.5f, 0),
        _ => new Vector3(4.0f, 21.0f, 0)
    };

